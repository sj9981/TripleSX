<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1000.0"
           stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.RegisterController"
           styleClass="auth-root">

    <VBox maxWidth="420.0" spacing="16.0" styleClass="auth-card">
        <padding>
            <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
        </padding>

        <Label text="Create account" styleClass="auth-title"/>
        <Label text="Join the platform" styleClass="auth-subtitle"/>

        <VBox spacing="8.0">
            <Label text="Username" styleClass="auth-label"/>
            <TextField fx:id="usernameField"
                       promptText="Choose a username"
                       styleClass="auth-field"/>
        </VBox>

        <VBox spacing="8.0">
            <Label text="Email" styleClass="auth-label"/>
            <TextField fx:id="emailField"
                       promptText="Enter your email"
                       styleClass="auth-field"/>
        </VBox>

        <VBox spacing="8.0">
            <Label text="Password" styleClass="auth-label"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField"
                                   promptText="Create a password"
                                   styleClass="auth-password"/>

                    <TextField fx:id="passwordVisibleField"
                               promptText="Create a password"
                               visible="false"
                               managed="false"
                               styleClass="auth-password"/>
                </StackPane>

                <Button fx:id="togglePasswordButton"
                        text="🙉"
                        onAction="#togglePasswordVisibility"
                        styleClass="eye-button"/>
            </HBox>
        </VBox>

        <Label fx:id="statusLabel"
               text=""
               wrapText="true"
               styleClass="auth-subtitle"/>

        <Button text="Sign Up"
                onAction="#handleSignUp"
                maxWidth="Infinity"
                styleClass="auth-button"/>

        <HBox spacing="5.0">
            <Label text="Already have an account?" styleClass="auth-subtitle"/>
            <Label text="Log in"
                   onMouseClicked="#goToLogin"
                   styleClass="auth-link"/>
        </HBox>
    </VBox>
</StackPane>

