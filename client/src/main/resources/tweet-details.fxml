<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="700.0" prefWidth="1000.0"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.TweetDetailsController">

    <VBox maxWidth="275.0" minWidth="220.0" prefWidth="250.0" spacing="10"
          style="-fx-border-color: #2f3336; -fx-border-width: 0 1 0 0; -fx-background-color: #000000;">
        <padding>
            <Insets bottom="20" left="20" right="10" top="20" />
        </padding>

        <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 0 0 20 10;" text="𝕏" />

        <Button maxWidth="Infinity" onAction="#handleGoToHome" styleClass="sidebar-button" text="  🏠  Home" />
        <Button maxWidth="Infinity" onAction="#handleGoToSearch" styleClass="sidebar-button" text="  🔎  Explore" />
        <Button maxWidth="Infinity" styleClass="sidebar-button" text="  🔔  Notifications" />
        <Button maxWidth="Infinity" styleClass="sidebar-button" text="  💬  Messages" />
        <Button maxWidth="Infinity" onAction="#handleGoToProfile" styleClass="sidebar-button" text="  👤  Profile" />

        <Region VBox.vgrow="ALWAYS" />
        <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-button" text="Logout" />
    </VBox>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color: black; -fx-background: black; -fx-border-color: transparent;">
        <content>
            <VBox spacing="0" maxWidth="650.0">
                <padding>
                    <Insets top="0" left="0" right="0" bottom="0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-padding: 15; -fx-border-color: #2f3336; -fx-border-width: 0 0 1 0;">
                    <Button text="←" onAction="#handleBack"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;"/>
                    <Label text="Post" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                </HBox>

                <VBox fx:id="mainTweetContainer" style="-fx-border-color: #2f3336; -fx-border-width: 0 0 1 0; -fx-padding: 15;"/>

                <VBox spacing="10" style="-fx-border-color: #2f3336; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
                    <HBox fx:id="replyTargetBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false" style="-fx-padding: 0 0 5 0;">
                        <Label fx:id="replyTargetLabel" text="Replying to @username" style="-fx-text-fill: #1d9bf0; -fx-font-size: 13px; -fx-font-weight: bold;" />
                        <Button text="✕" onAction="#handleCancelReplyTarget" style="-fx-background-color: transparent; -fx-text-fill: #71767b; -fx-padding: 0; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;" />
                    </HBox>
                    <TextArea fx:id="replyTextArea"
                              prefHeight="60"
                              promptText="Post your reply"
                              styleClass="tweet-box"
                              wrapText="true"/>
                    <HBox alignment="CENTER_RIGHT" spacing="15">
                        <Label fx:id="replyCharCountLabel" text="2000" style="-fx-text-fill: #71767b; -fx-font-size: 14px;" />
                        <Button fx:id="replyButton" text="Reply" onAction="#handlePostReply" styleClass="post-button"/>
                    </HBox>
                </VBox>

                <VBox fx:id="repliesContainer"/>
            </VBox>
        </content>
    </ScrollPane>

    <VBox prefWidth="300.0" spacing="15"
          style="-fx-border-color: #2f3336; -fx-border-width: 0 0 0 1; -fx-background-color: #000000;">
        <padding>
            <Insets top="20" left="20" right="20" bottom="20"/>
        </padding>

        <VBox spacing="15" styleClass="trends-panel">
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 800;" text="What's happening" />
            <VBox fx:id="trendsContainer" spacing="15" />
        </VBox>
    </VBox>

</HBox>