<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="700.0" prefWidth="1000.0"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.SearchController">

    <VBox prefWidth="250.0" spacing="10"
          style="-fx-border-color: #2f3336; -fx-border-width: 0 1 0 0; -fx-background-color: #000000;">
        <padding>
            <Insets top="20" left="20" right="10" bottom="20"/>
        </padding>

        <Label text="  𝕏"
               style="-fx-text-fill: white;
              -fx-font-size: 38px;
              -fx-font-weight: bold;
              -fx-padding: 0 0 20 10;"/>

        <Region prefHeight="20"/>
        <Button text="  🏠" onAction="#handleGoToHome" styleClass="sidebar-button" prefWidth="210.0" maxWidth="Infinity"/>
        <Button text="  🔎" styleClass="sidebar-button" prefWidth="210.0" maxWidth="Infinity" style="-fx-background-color: #181818;"/>
        <Button text="  🔔" styleClass="sidebar-button" prefWidth="210.0" maxWidth="Infinity"/>
        <Button text="  💬" styleClass="sidebar-button" prefWidth="210.0" maxWidth="Infinity"/>
        <Button text="  👤" onAction="#handleGoToProfile" styleClass="sidebar-button" prefWidth="210.0" maxWidth="Infinity"/>

        <Region VBox.vgrow="ALWAYS"/>
        <Button text="Logout" onAction="#handleLogout" styleClass="logout-button" maxWidth="Infinity"/>
    </VBox>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color: black; -fx-background: black; -fx-border-color: transparent;">
        <content>
            <VBox spacing="15" maxWidth="650.0">
                <padding>
                    <Insets top="15" left="15" right="15" bottom="15"/>
                </padding>

                <Label text="Search"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="🔍 Search users or tweets..."
                               styleClass="auth-field"
                               HBox.hgrow="ALWAYS"
                               onAction="#handleSearch"/>
                    <Button text="Search"
                            onAction="#handleSearch"
                            styleClass="post-button"/>
                </HBox>

                <VBox spacing="10">
                    <Label text="Users" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <VBox fx:id="usersContainer" spacing="10" />
                </VBox>

                <Separator style="-fx-background-color: #2f3336; -fx-opacity: 0.3;"/>

                <VBox spacing="10">
                    <Label text="Tweets" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <VBox fx:id="tweetsContainer" spacing="10" />
                </VBox>
            </VBox>
        </content>
    </ScrollPane>


    <VBox prefWidth="300.0" spacing="15"
          style="-fx-border-color: #2f3336; -fx-border-width: 0 0 0 1; -fx-background-color: #000000;">
        <padding>
            <Insets top="20" left="20" right="20" bottom="20"/>
        </padding>

        <VBox spacing="10" styleClass="trends-panel">
            <Label text="What's happening"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 800;"/>
            <Label text="#Java" style="-fx-text-fill: #1d9bf0;"/>
            <Label text="#TripleSX" style="-fx-text-fill: #1d9bf0;"/>
            <Label text="#I_need_help" style="-fx-text-fill: #1d9bf0;"/>
        </VBox>
    </VBox>

</HBox>