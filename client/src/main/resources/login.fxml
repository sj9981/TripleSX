<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.LoginController"
      style="-fx-background-color: #ffffff;">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Log in to X" style="-fx-font-weight: bold;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <VBox spacing="10.0">
        <Label text="Username" />
        <TextField fx:id="usernameField" promptText="Enter your username"
                   style="-fx-pref-height: 40; -fx-background-radius: 5;" />

        <Label text="Password" />
        <PasswordField fx:id="passwordField" promptText="Enter your password"
                       style="-fx-pref-height: 40; -fx-background-radius: 5;" />
    </VBox>

    <Label fx:id="statusLabel" textAlignment="CENTER" wrapText="true" />

    <VBox spacing="10.0" alignment="CENTER">
        <Button maxWidth="Infinity" style="-fx-background-color: #1DA1F2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-pref-height: 40; -fx-cursor: hand;"
                text="Log In" onAction="#handleLogin" />

        <HBox spacing="10.0" alignment="CENTER">
            <Label text="Don't have an account?" />
            <Button text="Register" onAction="#handleRegister"
                    style="-fx-background-color: transparent; -fx-text-fill: #1DA1F2; -fx-cursor: hand; -fx-underline: true;" />
        </HBox>
    </VBox>

</VBox>
