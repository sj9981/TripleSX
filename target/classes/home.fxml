<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Hyperlink?>

<?import javafx.scene.control.ProgressBar?>
<HBox prefHeight="700.0" prefWidth="1000.0"
      style="-fx-background-color: black;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.HomeController">

    <VBox maxWidth="275.0" minWidth="220.0" prefWidth="250.0" spacing="10"
          style="-fx-border-color: #2f3336; -fx-border-width: 0 1 0 0;">
        <padding>
            <Insets bottom="20" left="20" right="10" top="20" />
        </padding>

        <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 0 0 20 10;" text="𝕏" />

        <Button maxWidth="Infinity" styleClass="sidebar-button" text="  🏠  Home" />
        <Button maxWidth="Infinity" onAction="#handleGoToSearch" styleClass="sidebar-button" text="  🔎  Explore" />
        <Button maxWidth="Infinity" styleClass="sidebar-button" text="  🔔  Notifications" />
        <Button maxWidth="Infinity" styleClass="sidebar-button" text="  💬  Messages" />
        <Button maxWidth="Infinity" onAction="#handleGoToProfile" styleClass="sidebar-button" text="  👤  Profile" />

        <Region VBox.vgrow="ALWAYS" />
        <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-button" text="Logout" />
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
        <content>
            <VBox alignment="TOP_CENTER">
                <VBox maxWidth="600.0" spacing="0">

                    <VBox style="-fx-border-color: #2f3336; -fx-border-width: 0 0 1 0;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15;" text="Home" />
                    </VBox>

                    <VBox spacing="15" style="-fx-border-color: #2f3336; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
                        <HBox spacing="15">
                            <Circle fx:id="userAvatarCircle" fill="#333" radius="22" />
                            <VBox HBox.hgrow="ALWAYS" spacing="10">
                                <TextArea fx:id="tweetTextArea" prefHeight="100" promptText="What's happening?!" styleClass="tweet-box" wrapText="true" />

                                <HBox fx:id="imagePreviewContainer" spacing="10" visible="false" managed="false" style="-fx-padding: 5 0 5 0;" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15">
                            <!-- Visual character limit indicator -->
                            <ProgressBar fx:id="tweetProgressBar"
                                         progress="0.0"
                                         prefWidth="100.0"
                                         prefHeight="6.0"
                                         styleClass="tweet-progress-bar" />

                            <Label fx:id="charCountLabel"
                                   text="2000"
                                   style="-fx-text-fill: #71767b; -fx-font-size: 13px; -fx-font-weight: bold;" />

                            <Button onAction="#handleChooseImage"
                                    styleClass="image-button"
                                    text="📸" />

                            <Button fx:id="postButton"
                                    onAction="#handlePostTweet"
                                    styleClass="post-button"
                                    text="Post"
                                    disable="true" /> <!-- Disabled by default until user types -->
                        </HBox>
                    </VBox>

                    <VBox fx:id="feedContainer" />
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <VBox maxWidth="350.0" minWidth="280.0" prefWidth="320.0" spacing="20"
          style="-fx-border-color: #2f3336; -fx-border-width: 0 0 0 1;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <VBox spacing="15" styleClass="trends-panel">
            <Label style="-fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: 800;" text="What's happening" />
            <VBox fx:id="trendsContainer" spacing="15" />
        </VBox>
    </VBox>

</HBox>