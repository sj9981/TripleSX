<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="0"
      style="-fx-background-color: black;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.ProfileController">

    <StackPane prefHeight="150" style="-fx-background-color: #333333;">
        <ImageView fx:id="bannerImageView"
                   fitHeight="150"
                   fitWidth="800"
                   preserveRatio="false" />

        <Button text="←"
                onAction="#handleBack"
                StackPane.alignment="TOP_LEFT"
                style="-fx-text-fill: white; -fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 50; -fx-cursor: hand; -fx-font-size: 18px; -fx-font-weight: bold;">
            <StackPane.margin>
                <Insets top="10" left="10"/>
            </StackPane.margin>
        </Button>
    </StackPane>

    <VBox spacing="15">
        <padding>
            <Insets left="20" right="20" bottom="20"/>
        </padding>

        <!-- Avatar and Action Buttons) -->
        <HBox alignment="BOTTOM_LEFT" spacing="10">
            <VBox style="-fx-translate-y: -50;">
                <StackPane prefWidth="110" prefHeight="110" minWidth="110" minHeight="110" maxWidth="110" maxHeight="110">
                    <Circle radius="52" fill="#000000" stroke="black" strokeWidth="4"/>
                    <ImageView fx:id="avatarImageView"
                               fitWidth="100"
                               fitHeight="100"
                               preserveRatio="false" />
                </StackPane>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="followButton"
                        text="Follow"
                        onAction="#handleFollowAction"
                        visible="false"
                        managed="false"
                        style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"/>

                <Button fx:id="editProfileButton"
                        text="Edit Profile"
                        onAction="#handleEditProfile"
                        visible="false"
                        managed="false"
                        style="-fx-background-color: black; -fx-text-fill: white; -fx-border-color: #536471; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>

        <VBox spacing="2" style="-fx-translate-y: -25;">
            <Label fx:id="displayNameLabel"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label fx:id="usernameLabel"
                   style="-fx-font-size: 16; -fx-text-fill: #71767b;"/>

            <Label fx:id="bioLabel"
                   wrapText="true"
                   style="-fx-text-fill: white; -fx-font-size: 15;">
                <VBox.margin>
                    <Insets top="12"/>
                </VBox.margin>
            </Label>
        </VBox>

        <HBox spacing="20" style="-fx-translate-y: -10;">
            <HBox spacing="5">
                <Label fx:id="tweetCountLabel" text="0" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="Posts" style="-fx-text-fill: #71767b;"/>
            </HBox>

            <HBox spacing="5" onMouseClicked="#showFollowing" style="-fx-cursor: hand;">
                <Label fx:id="followingCountLabel" text="0" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="Following" style="-fx-text-fill: #71767b;"/>
            </HBox>

            <HBox spacing="5" onMouseClicked="#showFollowers" style="-fx-cursor: hand;">
                <Label fx:id="followerCountLabel" text="0" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="Followers" style="-fx-text-fill: #71767b;"/>
            </HBox>
        </HBox>

        <Separator style="-fx-background-color: #2f3336; -fx-opacity: 0.3;"/>

        <HBox spacing="40" alignment="CENTER">
            <Label text="Posts" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #1d9bf0; -fx-border-width: 0 0 4 0; -fx-padding: 0 0 10 0;"/>
            <Label text="Replies" style="-fx-text-fill: #71767b; -fx-padding: 0 0 10 0;"/>
            <Label text="Media" style="-fx-text-fill: #71767b; -fx-padding: 0 0 10 0;"/>
            <Label text="Likes" style="-fx-text-fill: #71767b; -fx-padding: 0 0 10 0;"/>
        </HBox>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: black; -fx-background-color: black; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="userTweetsContainer"
                      spacing="0"
                      style="-fx-background-color: black;"/>
            </content>
        </ScrollPane>
    </VBox>

</VBox>