<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.EditProfileController"
           style="-fx-background-color: #15202B;">

    <children>

        <!-- Back button in top-left -->
        <AnchorPane StackPane.alignment="TOP_LEFT" pickOnBounds="false">
            <children>
                <Button text="Back"
                        onAction="#handleBack"
                        layoutX="30"
                        layoutY="30"
                        style="-fx-background-color: #22303C;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;
                               -fx-padding: 8 18;
                               -fx-font-size: 14px;
                               -fx-cursor: hand;" />
            </children>
        </AnchorPane>

        <!-- Center card -->
        <VBox alignment="TOP_CENTER"
              spacing="18"
              maxWidth="520"
              prefWidth="520"
              style="-fx-background-color: #192734;
                     -fx-background-radius: 24;
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 20, 0.2, 0, 8);">

            <children>
                <Label text="Edit Profile"
                       style="-fx-text-fill: white;
                              -fx-font-size: 30px;
                              -fx-font-weight: bold;" />

                <!-- Avatar -->
                <StackPane prefWidth="120" prefHeight="120"
                           maxWidth="120" maxHeight="120"
                           style="-fx-background-color: #22303C;
                                  -fx-background-radius: 60;
                                  -fx-border-color: #1D9BF0;
                                  -fx-border-width: 3;
                                  -fx-border-radius: 60;">
                    <children>
                        <ImageView fx:id="profileImageView"
                                   fitWidth="110"
                                   fitHeight="110"
                                   preserveRatio="false"
                                   smooth="true"/>
                    </children>
                </StackPane>

                <Button text="Choose Photo"
                        onAction="#handleChoosePhoto"
                        style="-fx-background-color: #1D9BF0;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-padding: 10 24;
                               -fx-cursor: hand;" />

                <HBox alignment="CENTER" spacing="10">
                    <Button text="Remove Photo"
                            onAction="#handleRemovePhoto"
                            style="-fx-background-color: #22303C;
                   -fx-text-fill: #8899A6;
                   -fx-background-radius: 20;
                   -fx-padding: 10 24;
                   -fx-cursor: hand;" />
                </HBox>

                <TextField fx:id="nameField"
                           promptText="Display Name"
                           prefHeight="46"
                           maxWidth="460"
                           style="-fx-background-color: #22303C;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8899A6;
                                  -fx-background-radius: 14;
                                  -fx-border-radius: 14;
                                  -fx-border-color: transparent;
                                  -fx-font-size: 14px;
                                  -fx-padding: 0 14;" />

                <TextField fx:id="usernameField"
                           promptText="Username"
                           prefHeight="46"
                           maxWidth="460"
                           style="-fx-background-color: #22303C;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8899A6;
                                  -fx-background-radius: 14;
                                  -fx-border-radius: 14;
                                  -fx-border-color: transparent;
                                  -fx-font-size: 14px;
                                  -fx-padding: 0 14;" />

                <TextArea fx:id="bioField"
                          promptText="Bio"
                          wrapText="true"
                          prefHeight="140"
                          maxWidth="460"
                          style="-fx-control-inner-background: #22303C;
                                 -fx-text-fill: white;
                                 -fx-prompt-text-fill: #8899A6;
                                 -fx-background-radius: 14;
                                 -fx-border-radius: 14;
                                 -fx-border-color: transparent;
                                 -fx-font-size: 14px;
                                 -fx-padding: 10 14;" />

                <Button text="Save Changes"
                        onAction="#handleSave"
                        prefWidth="460"
                        prefHeight="48"
                        style="-fx-background-color: linear-gradient(to right, #1D9BF0, #1A8CD8);
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 24;
                               -fx-cursor: hand;" />
            </children>
        </VBox>

    </children>
</StackPane>