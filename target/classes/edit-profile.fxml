<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="client.EditProfileController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000.0" prefHeight="700.0"
            style="-fx-background-color: black;">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              prefHeight="80"
              style="-fx-background-color: #2b2b2b; -fx-padding: 20;">
            <Button text="Back"
                    onAction="#handleBack"
                    style="-fx-background-color: #1f1f1f;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-background-radius: 20;
                           -fx-padding: 8 18;
                           -fx-cursor: hand;" />
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding: 40 0 0 0;">

            <Label text="Edit Profile"
                   style="-fx-text-fill: white;
                          -fx-font-size: 42px;
                          -fx-font-weight: bold;" />

            <VBox spacing="18" maxWidth="750" alignment="CENTER">
                <TextField fx:id="nameField"
                           promptText="Name"
                           prefWidth="750"
                           prefHeight="45"
                           style="-fx-background-color: #f5f5f5;
                                  -fx-text-fill: black;
                                  -fx-prompt-text-fill: #a0a0a0;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-font-size: 20px;
                                  -fx-padding: 0 12;" />

                <TextField fx:id="usernameField"
                           promptText="Username"
                           prefWidth="750"
                           prefHeight="45"
                           style="-fx-background-color: #f5f5f5;
                                  -fx-text-fill: black;
                                  -fx-prompt-text-fill: #a0a0a0;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-font-size: 20px;
                                  -fx-padding: 0 12;" />

                <TextArea fx:id="bioField"
                          promptText="Bio"
                          wrapText="true"
                          prefWidth="750"
                          prefHeight="140"
                          style="-fx-background-color: #f5f5f5;
                                 -fx-text-fill: black;
                                 -fx-prompt-text-fill: #a0a0a0;
                                 -fx-background-radius: 8;
                                 -fx-border-radius: 8;
                                 -fx-font-size: 18px;
                                 -fx-padding: 10;" />
            </VBox>

            <Button text="Save"
                    onAction="#handleSave"
                    prefWidth="120"
                    prefHeight="42"
                    style="-fx-background-color: #1d9bf0;
                           -fx-text-fill: white;
                           -fx-font-size: 18px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 22;
                           -fx-cursor: hand;" />
        </VBox>
    </center>

</BorderPane>
