<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1000.0"
           stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.LoginController"
           styleClass="auth-root">

    <VBox maxWidth="380.0" spacing="16.0" styleClass="auth-card">
        <padding>
            <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
        </padding>

        <Label text="Welcome back" styleClass="auth-title"/>
        <Label text="Log in to your account" styleClass="auth-subtitle"/>

        <VBox spacing="8.0">
            <Label text="Username" styleClass="auth-label"/>
            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       styleClass="auth-field"/>
        </VBox>

        <VBox spacing="8.0">
            <Label text="Password" styleClass="auth-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           styleClass="auth-password"/>
        </VBox>

        <Label fx:id="statusLabel"
               text=""
               wrapText="true"
               styleClass="auth-subtitle"/>

        <Button text="Log In"
                onAction="#handleLogin"
                maxWidth="Infinity"
                styleClass="auth-button"/>

        <HBox spacing="5.0">
            <Label text="Don't have an account?" styleClass="auth-subtitle"/>
            <Label text="Sign up"
                   onMouseClicked="#handleRegister"
                   styleClass="auth-link"/>
        </HBox>
    </VBox>
</StackPane>